generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Reserva {
  id                   Int      @id @default(autoincrement())
  reservation_id       String   @unique @db.VarChar(50)
  nombre               String   @db.VarChar(255)
  telefono             String   @db.VarChar(20)
  email                String   @db.VarChar(255)
  fecha                DateTime @db.Date
  horario              String   @db.VarChar(10)
  servicios            Json
  productos            Json?    @default("[]")
  total                Decimal  @db.Decimal(10, 2)
  estado               String   @default("pendiente") @db.VarChar(50)
  notas                String?
  fisioterapeuta       String?  @db.VarChar(255)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  codigo_afiliado      String?  @db.VarChar(50)
  descuento_afiliado   Decimal  @default(0) @db.Decimal(10, 2)
  descuento_individual Decimal  @default(0) @db.Decimal(10, 2)
  descuento_promocion  Decimal  @default(0) @db.Decimal(10, 2)

  @@index([fecha, horario], map: "idx_fecha_horario")
  @@index([estado], map: "idx_estado")
  @@index([reservation_id], map: "idx_reservation_id")
  @@map("reservas")
}

model Servicio {
  id                   Int      @id @default(autoincrement())
  servicio_id          String   @unique @db.VarChar(50)
  nombre               String   @db.VarChar(255)
  descripcion          String?
  categoria            String   @db.VarChar(100)
  duracion             Int      @default(30)
  precio               Decimal  @db.Decimal(10, 2)
  icon                 String?  @db.VarChar(10)
  imagen               String?  @db.VarChar(500)
  activo               Boolean  @default(true)
  orden                Int      @default(0)
  detalles             Json?
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  descuento            Int      @default(0)
  detalles_tratamiento String?

  @@index([activo], map: "idx_servicio_activo")
  @@index([categoria], map: "idx_servicio_categoria")
  @@map("servicios")
}

model ServicioAdicional {
  id                Int      @id @default(autoincrement())
  servicio_id       String   @unique @db.VarChar(50)
  nombre            String   @db.VarChar(255)
  descripcion       String?
  precio_particular Decimal  @db.Decimal(10, 2)
  precio_afiliado   Decimal  @db.Decimal(10, 2)
  icon              String?  @db.VarChar(10)
  activo            Boolean  @default(true)
  orden             Int      @default(0)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([activo], map: "idx_servicio_adicional_activo")
  @@map("servicios_adicionales")
}

model Producto {
  id          Int      @id @default(autoincrement())
  producto_id String   @unique @db.VarChar(50)
  nombre      String   @db.VarChar(255)
  descripcion String?
  precio      Decimal  @db.Decimal(10, 2)
  icon        String?  @db.VarChar(10)
  stock       Int?
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([activo], map: "idx_producto_activo")
  @@map("productos")
}

model Horario {
  id         Int      @id @default(autoincrement())
  hora       String   @unique @db.VarChar(5)
  activo     Boolean  @default(true)
  orden      Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([activo], map: "idx_horario_activo")
  @@map("horarios")
}

model Configuracion {
  id                   Int      @id @default(autoincrement())
  clave                String   @unique @db.VarChar(100)
  valor                String
  tipo                 String   @db.VarChar(50)
  descripcion          String?
  categoria            String   @db.VarChar(100)
  editable_por_gerente Boolean  @default(true)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([categoria], map: "idx_configuracion_categoria")
  @@map("configuracion")
}

model Promocion {
  id               Int      @id @default(autoincrement())
  promocion_id     String   @unique @db.VarChar(50)
  nombre           String   @db.VarChar(255)
  descripcion      String?
  tipo             String   @db.VarChar(50)
  valor_descuento  Decimal  @db.Decimal(10, 2)
  precio_minimo    Decimal? @db.Decimal(10, 2)
  aplicable_a      String   @db.VarChar(50)
  items_incluidos  Json?
  fecha_inicio     DateTime @db.Date
  fecha_fin        DateTime @db.Date
  dias_validos     Json?
  horario_inicio   String?  @db.VarChar(5)
  horario_fin      String?  @db.VarChar(5)
  maximo_usos      Int?
  usos_actuales    Int      @default(0)
  activo           Boolean  @default(true)
  prioridad        Int      @default(0)
  codigo_promocion String?  @db.VarChar(50)
  visible_web      Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([activo], map: "idx_promocion_activo")
  @@index([fecha_inicio, fecha_fin], map: "idx_promocion_fechas")
  @@index([tipo], map: "idx_promocion_tipo")
  @@map("promociones")
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("admin_users")
}

model WebContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(50)
  title     String?  @db.VarChar(255)
  content   String?
  image     String?  @db.VarChar(500)
  section   String   @db.VarChar(50)
  active    Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([section], map: "idx_web_content_section")
  @@map("web_content")
}

model FAQ {
  id        Int      @id @default(autoincrement())
  question  String   @db.VarChar(500)
  answer    String
  order     Int      @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([active], map: "idx_faq_active")
  @@map("faqs")
}
