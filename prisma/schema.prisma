// Prisma Schema para Therapy Aqua Spa
// Base de datos: Neon Postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

// Modelo de Reservas
// Refleja exactamente la estructura usada en lib/db.ts
model Reserva {
  id                    Int      @id @default(autoincrement())
  reservation_id        String   @unique @db.VarChar(50)
  nombre                String   @db.VarChar(255)
  telefono              String   @db.VarChar(20)
  email                 String   @db.VarChar(255)
  fecha                 DateTime @db.Date
  horario               String   @db.VarChar(10)
  servicios             Json     // Array de servicios seleccionados
  productos             Json?    @default("[]") // Array de productos adicionales
  total                 Decimal  @db.Decimal(10, 2)
  estado                String   @default("pendiente") @db.VarChar(50) // pendiente | pendiente de pago | confirmada | cancelada | completada
  notas                 String?  @db.Text
  fisioterapeuta        String?  @db.VarChar(255)
  created_at            DateTime @default(now()) @db.Timestamptz()
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamptz()
  codigo_afiliado       String?  @db.VarChar(50)
  descuento_afiliado    Decimal  @default(0) @db.Decimal(10, 2)
  descuento_individual  Decimal  @default(0) @db.Decimal(10, 2)
  descuento_promocion   Decimal  @default(0) @db.Decimal(10, 2)

  @@index([fecha, horario], name: "idx_fecha_horario")
  @@index([estado], name: "idx_estado")
  @@index([reservation_id], name: "idx_reservation_id")
  @@map("reservas")
}
